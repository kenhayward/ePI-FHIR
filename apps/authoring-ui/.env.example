# Where the authoring surface is pointed. Read at build time, because a static bundle has no
# server to read configuration on start-up: a deployment elsewhere is a different build.
#
# These match the development stack in deploy/docker-compose. Copy to .env.local to change them.
VITE_EPI_AUTHORITY=http://localhost:8081/realms/epi
VITE_EPI_CLIENT_ID=epi-authoring-ui
VITE_EPI_API=http://localhost:8000
