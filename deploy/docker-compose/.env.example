# Copy to .env and adjust. Dev defaults only - never use in test/prod.

# PostgreSQL (shared)
POSTGRES_USER=epi
POSTGRES_PASSWORD=devpassword

# MinIO (object store + WORM)
MINIO_ROOT_USER=epiadmin
MINIO_ROOT_PASSWORD=devpassword123

# Keycloak (identity)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Grafana (observability profile)
GRAFANA_ADMIN_PASSWORD=admin

# Host ports. Defaults are in docker-compose.yml and apply when these are unset;
# override any that a local agent has already taken. On Windows, check with
#   netstat -ano | findstr :9001
# and identify the holder with
#   Get-Process -Id <pid>
# Corporate endpoint agents are common squatters - Zscaler's tunnel binds 9001,
# which is MinIO's console by default.
#POSTGRES_PORT=5432
#HAPI_PORT=8090
#ELASTICSEARCH_PORT=9200
#SNOWSTORM_PORT=8091
#OPENSEARCH_PORT=9201
#MINIO_PORT=9000
#MINIO_CONSOLE_PORT=9001
#KAFKA_PORT=9092
#KEYCLOAK_PORT=8081
#OPA_PORT=8181
#GOTENBERG_PORT=3000
#EPI_API_PORT=8080
#OTEL_GRPC_PORT=4317
#OTEL_HTTP_PORT=4318
#PROMETHEUS_PORT=9090
#GRAFANA_PORT=3001
#EPI_UI_PORT=5173
#KONG_PROXY_PORT=8000
#KONG_ADMIN_PORT=8001
#RABBITMQ_PORT=5672
#RABBITMQ_CONSOLE_PORT=15672
