# Copy to .env and adjust. Dev defaults only - never use in test/prod.

# PostgreSQL (shared)
POSTGRES_USER=epi
POSTGRES_PASSWORD=devpassword

# MinIO (object store + WORM)
MINIO_ROOT_USER=epiadmin
MINIO_ROOT_PASSWORD=devpassword123

# Keycloak (identity)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Grafana (observability profile)
GRAFANA_ADMIN_PASSWORD=admin
